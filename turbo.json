{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".wrangler/**"],
      "env": ["NODE_ENV", "CLOUDFLARE_ENV"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "deploy:check": {
      "cache": false
    },
    "deploy:dev": {
      "cache": false,
      "interactive": true
    },
    "deploy:prod": {
      "cache": false,
      "interactive": true
    },
    "migrate:dev": {
      "cache": false,
      "interactive": true
    },
    "migrate:prod": {
      "cache": false,
      "interactive": true
    },
    "generate:types": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "ios": {
      "persistent": true,
      "cache": false
    },
    "android": {
      "persistent": true,
      "cache": false
    }
  }
}
