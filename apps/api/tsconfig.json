{
  "extends": "@kn/config/base.json",
  "include": ["src", "vitest.config.ts"],
  "compilerOptions": {
    // The Worker is bundled by wrangler/esbuild, never by `tsc`. `noEmit` is what keeps `tsc -b`
    // a type check rather than a second, unused build sitting next to the source (the stray-output
    // trap the root `.gitignore` guards against).
    "noEmit": true,
    "paths": {
      "@api/*": ["./src/*"]
    },
    // `@cloudflare/workers-types` rather than `./worker-configuration.d.ts`, deliberately:
    // `worker-configuration.d.ts` is GENERATED by `bun run cf-typegen` and is not committed, so
    // naming it here would make `bun run check` fail on a fresh clone before anyone has run
    // wrangler once. Nothing in this app needs the generated `CloudflareBindings` interface — the
    // Worker's environment is `Env` from `@kn/server/Runtime/WorkerEnv`, hand-written so that a
    // binding rename is a type error rather than a regenerated file nobody reads. Add the
    // generated file to this array only if you start consuming `CloudflareBindings` directly.
    "types": ["@cloudflare/workers-types"]
  }
}
