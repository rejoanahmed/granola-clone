# apps/api local secrets — copy to `.dev.vars`, which wrangler dev loads automatically.
#
#   cp apps/api/.dev.vars.example apps/api/.dev.vars
#
# Everything NON-secret already lives in `wrangler.jsonc` under `vars` (API_URL, NATIVE_SCHEME,
# NODE_ENV, the E2E and flag switches) — this file is only for values that must not be in git. In
# a deployed environment the same names are dashboard secrets, and `keep_vars: true` in
# wrangler.jsonc is what stops a deploy from pruning them.
#
# `Runtime/AppConfig.ts` parses these once, at container build. A missing or malformed value is a
# 500 on the first request after a bad deploy, with the variable named in the message.

# ── Auth ──────────────────────────────────────────────────────────────────────────────────────

# better-auth's signing key. 32+ random bytes: `openssl rand -base64 32`.
# Rotating it invalidates every session.
BETTER_AUTH_SECRET=""

# Optional Google sign-in. Leave BOTH empty and the provider is simply not registered — half of a
# pair is the one configuration that fails at the redirect rather than at startup.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── E2E harness ───────────────────────────────────────────────────────────────────────────────

# Required whenever E2E_HARNESS=true (it is, at the top level of wrangler.jsonc): the Worker will
# not start without it, and 32 characters is the floor. `openssl rand -base64 32`.
# On the deployed dev Worker this is a dashboard secret; production never has either name.
E2E_SECRET="local-dev-e2e-secret-change-me-32ch"
