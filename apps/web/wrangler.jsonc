/**
 * The landing page is a Worker, not a static bucket, as the publisher's other app's web is (D033).
 *
 * `main` is src/server.ts: TanStack Start's handler behind one host check that folds the old
 * workers.dev address into rovierr.com/kothanote. Assets are uploaded by `vite build` and served by
 * the same Worker. No bindings on purpose: the page reads nothing and holds nothing, so losing this
 * Worker loses a brochure, not data.
 *
 * There is no domain of its own (D035). The site is a path on rovierr.com, whose zone is on this
 * account: the route below sends `rovierr.com/kothanote*` here, and every other path stays with
 * the rovierr.com Worker. The build puts every page, asset and public file under `/kothanote`
 * (vite.config.ts), so nothing this Worker serves needs a path outside its route.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kothanote-web",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./src/server.ts",
	"observability": { "enabled": true },
	"routes": [{ "pattern": "rovierr.com/kothanote*", "zone_name": "rovierr.com" }],
	// Kept on so the old address can redirect (src/server.ts) rather than vanish.
	"workers_dev": true,
	"preview_urls": false
}
