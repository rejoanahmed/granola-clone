/**
 * The web app is a Worker, not a static bucket.
 *
 * `main` points at TanStack Start's own server entry rather than a file in src/: the SSR handler
 * is generated by the Vite plugin, so there is nothing here to hand-write. Assets are uploaded by
 * `vite build` and served by the same Worker.
 *
 * There are no bindings on purpose. The browser talks to apps/api over HTTP with a cookie, so the
 * web Worker holds no D1, no KV and no secrets — losing this Worker loses a renderer, not data.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "eventsbd-web",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"main": "@tanstack/react-start/server-entry",
	"observability": { "enabled": true },

	// Chosen at BUILD time, not deploy time: `@cloudflare/vite-plugin` reads CLOUDFLARE_ENV, bakes
	// the environment into `.wrangler/deploy/config.json`, and `wrangler deploy` then takes no
	// `--env` — passing one that disagrees is an error. The package.json scripts set it.
	//
	// Which API the bundle calls is a build-time constant too (VITE_API_URL, baked into the
	// JavaScript the browser downloads), so it cannot live here: `vars` in this file reach the SSR
	// Worker, never the browser. That is also why a dev build must never be deployed to production —
	// it would point every visitor's browser at the dev API. Those two URLs are set per script in
	// package.json and must stay equal to `API_URL` / `APP_URL` in the matching environment of
	// apps/api/wrangler.jsonc: the API's CORS allow-list and better-auth's trusted origins are
	// built from its copy, and a mismatch reads as "logged out" rather than as a misconfiguration.
	"env": {
		"dev": {
			"name": "eventsbd-web-dev",
			// No workers.dev: the custom domain is the only public surface.
			"workers_dev": false,
			"routes": [{ "pattern": "dev.eventsbd.com", "custom_domain": true }],
			"observability": { "enabled": true }
		},
		"production": {
			"name": "eventsbd-web-prod",
			"workers_dev": false,
			"routes": [{ "pattern": "eventsbd.com", "custom_domain": true }],
			"observability": { "enabled": true }
		}
	}
}
