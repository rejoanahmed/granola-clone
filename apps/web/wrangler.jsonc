/**
 * The landing page is a Worker, not a static bucket, as the publisher's other app's web is (D033).
 *
 * `main` is TanStack Start's own server entry: the SSR handler is generated by the Vite plugin.
 * Assets are uploaded by `vite build` and served by the same Worker. No bindings on purpose: the
 * page reads nothing and holds nothing, so losing this Worker loses a brochure, not data.
 *
 * The site runs on workers.dev until kothanote.app is registered and its zone is on this account;
 * then add `"routes": [{ "pattern": "kothanote.app", "custom_domain": true }]` to `production`.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kothanote-web",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"main": "@tanstack/react-start/server-entry",
	"observability": { "enabled": true },
	"workers_dev": true,
	"preview_urls": false
}
