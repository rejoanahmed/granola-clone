# Copy to .env. Vite exposes ONLY VITE_-prefixed names to the browser bundle, so never put a
# secret here: everything in this file ships to every visitor.

# Where apps/api answers. The browser calls it directly — there is no dev proxy — so this origin
# must be in the API's CORS allow-list and must match the origin better-auth is mounted on, or
# every authenticated request comes back looking like "logged out".
VITE_API_URL="http://localhost:3001"

# Where this app answers. The bKash callback redirects the attendee to ${VITE_APP_URL}/payment/return,
# so the API's APP_URL and this value are the same string seen from two sides.
VITE_APP_URL="http://localhost:3003"
