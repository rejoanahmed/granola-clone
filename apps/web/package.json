{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "cf-typegen": "wrangler types",
    "deploy:check": "CLOUDFLARE_ENV=production VITE_API_URL=https://api.gcnotes.example.com VITE_APP_URL=https://gcnotes.example.com bun run build && wrangler deploy --dry-run",
    "deploy:dev": "CLOUDFLARE_ENV=dev VITE_API_URL=https://api-dev.gcnotes.example.com VITE_APP_URL=https://dev.gcnotes.example.com bun run build && wrangler deploy",
    "deploy:prod": "CLOUDFLARE_ENV=production VITE_API_URL=https://api.gcnotes.example.com VITE_APP_URL=https://gcnotes.example.com bun run build && wrangler deploy",
    "dev": "vite dev --port 3003",
    "generate:types": "wrangler types",
    "preview": "bun run build && vite preview",
    "test": "vitest run",
    "type-check": "tsc -b"
  },
  "dependencies": {
    "@gc/apiclient": "workspace:*",
    "@gc/auth": "workspace:*",
    "@gc/domain": "workspace:*",
    "@gc/shared": "workspace:*",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-query-devtools": "5.103.2",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.168.57",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.57.3",
    "@gc/config": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.40",
    "@types/node": "26.6.2",
    "@types/react": "~19.2.10",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.136.3"
  }
}
