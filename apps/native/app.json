{
  "expo": {
    "name": "Notes",
    "slug": "gcnotes",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["ios"],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "scheme": "gcnotes",
    "experiments": {
      "tsconfigPaths": true,
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-build-properties",
      "expo-font",
      "expo-asset",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#0b0b0c"
          },
          "resizeMode": "contain"
        }
      ]
    ],
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.rejoan.gcnotes",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
