{
  "expo": {
    "name": "Kothanote",
    "slug": "kothanote",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "platforms": ["ios", "android"],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "scheme": "kothanote",
    "experiments": {
      "tsconfigPaths": true,
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-build-properties",
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/Newsreader-Regular.ttf"]
        }
      ],
      "expo-asset",
      [
        "expo-audio",
        {
          "enableBackgroundRecording": true,
          "microphonePermission": "Kothanote needs microphone access to transcribe your meeting",
          "recordAudioAndroid": true
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#24262A",
          "resizeMode": "contain"
        }
      ]
    ],
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "buildNumber": "1",
      "bundleIdentifier": "com.rovierr.kothanote",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      }
    },
    "extra": {
      "router": {
        "origin": false
      }
    },
    "owner": "rovierr",
    "icon": "./assets/images/icon.png",
    "android": {
      "package": "com.kothanote.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundImage": "./assets/images/adaptive-background.png",
        "monochromeImage": "./assets/images/adaptive-monochrome.png"
      },
      "permissions": ["android.permission.RECORD_AUDIO"]
    }
  }
}
