{
  "expo": {
    "name": "Kothanote",
    "slug": "kothanote",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "platforms": ["ios"],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "scheme": "kothanote",
    "experiments": {
      "tsconfigPaths": true,
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-build-properties",
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/Newsreader-Regular.ttf"]
        }
      ],
      "expo-asset",
      [
        "expo-audio",
        {
          "enableBackgroundRecording": true,
          "microphonePermission": "Kothanote needs microphone access to transcribe your meeting"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#24262A",
          "resizeMode": "contain"
        }
      ]
    ],
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "buildNumber": "1",
      "bundleIdentifier": "com.rovierr.kothanote",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
