{
  "cli": {
    "version": ">= 17.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "extends": "production",
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "local"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "buildConfiguration": "Debug",
        "simulator": true
      }
    },
    "development-device": {
      "extends": "development",
      "channel": "development-device",
      "ios": {
        "buildConfiguration": "Debug",
        "simulator": false
      }
    },
    "preview": {
      "extends": "production",
      "environment": "preview",
      "autoIncrement": false,
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true",
        "EXPO_PUBLIC_APP_ENV": "dev"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "bun": "1.4.2",
      "environment": "production",
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true",
        "EXPO_PUBLIC_APP_ENV": "prod"
      }
    },
    "apk-prod": {
      "extends": "production",
      "distribution": "internal",
      "env": {
        "KOTHANOTE_RELEASE_ENV": "prod"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "apk-dev": {
      "extends": "preview",
      "autoIncrement": true,
      "env": {
        "KOTHANOTE_RELEASE_ENV": "dev"
      }
    },
    "apk-local": {
      "extends": "preview",
      "environment": "development",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "local",
        "KOTHANOTE_RELEASE_ENV": "local"
      }
    }
  },
  "submit": {
    "internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      },
      "ios": {
        "appleTeamId": "BXW3A78H2C"
      }
    },
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      },
      "ios": {
        "appleTeamId": "BXW3A78H2C"
      }
    }
  }
}
