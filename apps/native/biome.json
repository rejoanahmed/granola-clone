{
  "root": false,
  "extends": "//",
  "javascript": {
    "globals": ["__DEV__"]
  },
  "linter": {
    "rules": {
      "correctness": {
        "noGlobalDirnameFilename": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [".maestro/scripts/**"],
      "javascript": {
        "globals": [
          "API_URL",
          "E2E_SECRET",
          "EMAIL",
          "EXPECT_BODY",
          "EXPECT_SUBJECT",
          "KIND",
          "MODE",
          "PRESET",
          "ROLE",
          "TIMES",
          "http",
          "json",
          "output"
        ]
      }
    },
    {
      "includes": ["test/**/*"],
      "javascript": {
        "globals": [
          "afterAll",
          "afterEach",
          "beforeAll",
          "beforeEach",
          "describe",
          "expect",
          "it",
          "jest",
          "test"
        ]
      }
    }
  ]
}
