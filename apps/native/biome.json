{
  "root": false,
  "extends": "//",
  "javascript": {
    "globals": ["__DEV__"]
  },
  "linter": {
    "rules": {
      "correctness": {
        "noGlobalDirnameFilename": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [".maestro/scripts/**"],
      "javascript": {
        "globals": ["API_URL", "E2E_SECRET", "EMAIL", "http", "json", "output"]
      }
    },
    {
      "includes": ["test/**/*"],
      "javascript": {
        "globals": [
          "afterAll",
          "afterEach",
          "beforeAll",
          "beforeEach",
          "describe",
          "expect",
          "it",
          "jest",
          "test"
        ]
      }
    }
  ]
}
