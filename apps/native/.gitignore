# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native projects are generated by `expo prebuild` — regenerate, never commit.
/ios
/android

# Local env. EAS builds get their values from eas.json / EAS environment variables.
.env.local

# Build artefacts
*.jsbundle
*.apk
*.aab
*.ipa
*.tar.gz

# Signing material — never, under any circumstances
*.jks
*.p8
*.p12
*.key
*.mobileprovision
google-services.json
GoogleService-Info.plist

# macOS / Xcode / Gradle leftovers if someone builds locally without prebuild --clean
.DS_Store
*.xcuserstate
