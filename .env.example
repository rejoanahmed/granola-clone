# gcnotes — every variable the repo reads, in one place. No real values.
#
# This file is a catalogue, not a file you copy wholesale: each surface loads its own.
#   apps/api     -> cp apps/api/.dev.vars.example apps/api/.dev.vars   (wrangler reads .dev.vars)
#   apps/web     -> cp apps/web/.env.example apps/web/.env             (vite reads VITE_* only)
#   apps/native  -> apps/native/.env                                   (expo reads EXPO_PUBLIC_* only)
#
# Anything without a default is required; the Worker fails fast in Runtime/AppConfig.ts rather
# than serving a request with half a configuration.

# ─── apps/api (bindings live in wrangler.jsonc; these are vars and secrets) ───────────────────

# Where the API answers. Used to build absolute URLs the client and bKash are sent back to.
API_URL="http://localhost:3001"
# Where the web app answers. The bKash callback redirects the attendee here.
APP_URL="http://localhost:3003"
# development | production | test. Only `development` relaxes cookie and CORS strictness.
NODE_ENV="development"

# better-auth signing secret. 32+ random bytes; rotate it and every session is invalidated.
BETTER_AUTH_SECRET=""
# Must match the origin better-auth is mounted on, including the scheme and port.
BETTER_AUTH_URL="http://localhost:3001"
# Deep-link scheme for apps/native. Also the value in apps/native/app.json.
NATIVE_SCHEME="gcnotes"

# Optional social sign-in. Leave both empty and the provider is simply not registered.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Dev-only E2E harness. `true` arms the routes under /e2e; E2E_SECRET is the `x-e2e-secret` they
# demand, 32+ characters, and the Worker refuses to start armed without it. Both are absent from
# production, where NODE_ENV=production makes an armed harness a startup failure.
E2E_HARNESS="true"
E2E_SECRET=""

# fake | live. `fake` selects makeBkashFake in container.ts, which is what local dev and the E2E
# path use — the same object graph, a scripted leaf. Never `live` outside a real deployment.
BKASH_MODE="fake"
# Sandbox: https://tokenized.sandbox.bka.sh/v1.2.0-beta — required only when BKASH_MODE=live.
BKASH_BASE_URL=""
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
# Where bKash sends the attendee's browser after checkout. Must be reachable from their device,
# so a tunnel URL locally, not localhost, if you are testing on a phone.
BKASH_CALLBACK_URL="http://localhost:3001/payments/bkash/callback"
# HMAC-SHA256 key for the x-bkash-signature header on POST /payments/bkash/webhook. Required in
# every mode: an unverified webhook is rejected before it is even looked up.
BKASH_WEBHOOK_SECRET=""

# Minutes a seat hold survives before the cron sweeps it. Default 30.
HOLD_MINUTES="30"
# Minutes before an unsettled payment is re-queried against bKash. Default 45, i.e. comfortably
# longer than the hold, so the reconciler sees the finished story rather than a half-told one.
PAYMENT_STALE_MINUTES="45"

# ─── packages/db (drizzle-kit reads these from the shell; nothing else does) ──────────────────

# Set all three and drizzle.config.ts switches to the d1-http driver, so `db:migrate` and
# `db:studio` talk to the deployed D1 instead of the local miniflare file. Leave them empty for
# local work — that is the safe default, and it is why the switch is all-or-nothing.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DATABASE_ID=""
# A D1-scoped API token. Never a global key: this one is enough to drop the production tables.
CLOUDFLARE_D1_TOKEN=""
# Overrides the sqlite file drizzle-kit opens when the three above are empty. `db:studio` sets it
# itself from the newest .wrangler state file, so you rarely set it by hand.
DATABASE_URL=""

# ─── apps/web (Vite: only VITE_-prefixed names reach the browser) ─────────────────────────────

VITE_API_URL="http://localhost:3001"
VITE_APP_URL="http://localhost:3003"

# ─── apps/native (Expo: only EXPO_PUBLIC_-prefixed names reach the bundle) ────────────────────

# dev | prod. Selects the tier in src/config/; the API URL comes from the tier, not from env.
EXPO_PUBLIC_APP_ENV="dev"
